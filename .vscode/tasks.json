{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Playdate: configure (simulator, debug)",
			"type": "shell",
			"command": "cmake -S . -B build-sim-debug -DBOARD_NAME=playdate -DCMAKE_BUILD_TYPE=Debug",
			"problemMatcher": []
		},
		{
			"label": "Playdate: build (simulator, debug)",
			"type": "shell",
			"command": "touch port/boards/playdate/main.c && cmake --build build-sim-debug -j 8",
			"dependsOn": "Playdate: configure (simulator, debug)",
			"problemMatcher": ["$gcc"],
			"group": { "kind": "build", "isDefault": true }
		},
		{
			"label": "Playdate: clean (simulator)",
			"type": "shell",
			// Build trees (they hold quake.pdx) plus the pdex library that the
			// simulator build copies into Source/. Device outputs are untouched.
			"command": "rm -rf build-sim build-sim-debug port/boards/playdate/Source/pdex.dylib port/boards/playdate/Source/pdex.so port/boards/playdate/Source/pdex.dll",
			"problemMatcher": []
		},
		{
			"label": "Playdate: build (device)",
			"type": "shell",
			"command": "cmake -S . -B build-dev -DCMAKE_TOOLCHAIN_FILE=port/boards/playdate/toolchain.cmake -DBOARD_NAME=playdate && cmake --build build-dev -j 8",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Playdate: clean build (device)",
			"type": "shell",
			// Remove the build tree and the stale pdex.* binaries that pdc would
			// otherwise bundle into the .pdx, then rebuild from scratch.
			"command": "rm -rf build-dev port/boards/playdate/Source/pdex.* && cmake -S . -B build-dev -DCMAKE_TOOLCHAIN_FILE=port/boards/playdate/toolchain.cmake -DBOARD_NAME=playdate && cmake --build build-dev -j 8",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Install on device (USB)",
			"type": "shell",
			"dependsOn": "Playdate: clean build (device)",
			"command": "./scripts/install-device.sh",
			"problemMatcher": []
		}
	]
}
